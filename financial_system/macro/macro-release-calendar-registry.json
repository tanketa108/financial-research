{
  "version": "0.1",
  "scope": "US macro releases v0",
  "owner": "Charlie / Financial Research System",
  "status": "seed",
  "principles": [
    "Official sources first",
    "Track release period, release time, units and revision status",
    "Separate raw data from interpretation",
    "Use consensus/surprise only when source is explicit"
  ],
  "releases": [
    {
      "id": "us_cpi",
      "name": "Consumer Price Index",
      "sourceAgency": "BLS",
      "category": "inflation",
      "frequency": "monthly",
      "importance": "high",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.bls.gov/schedule/news_release/cpi.htm",
      "officialDataUrl": "https://www.bls.gov/cpi/",
      "primarySeries": ["CPIAUCSL", "CPILFESL"],
      "reportFields": ["headline_mom", "headline_yoy", "core_mom", "core_yoy", "revision_status"],
      "interpretationHint": "Core services, shelter and sequential momentum matter more than headline noise."
    },
    {
      "id": "us_ppi",
      "name": "Producer Price Index",
      "sourceAgency": "BLS",
      "category": "inflation",
      "frequency": "monthly",
      "importance": "medium",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.bls.gov/schedule/news_release/ppi.htm",
      "officialDataUrl": "https://www.bls.gov/ppi/",
      "primarySeries": [],
      "reportFields": ["headline_mom", "headline_yoy", "core_mom", "core_yoy", "revision_status"],
      "interpretationHint": "Useful for pipeline inflation and some PCE components, but lower signal than CPI/Core PCE."
    },
    {
      "id": "us_employment_situation",
      "name": "Employment Situation / Nonfarm Payrolls",
      "sourceAgency": "BLS",
      "category": "labor",
      "frequency": "monthly",
      "importance": "high",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.bls.gov/schedule/news_release/empsit.htm",
      "officialDataUrl": "https://www.bls.gov/ces/",
      "primarySeries": ["PAYEMS", "UNRATE", "AHEYOY"],
      "reportFields": ["payrolls_change", "prior_revisions", "unemployment_rate", "participation_rate", "avg_hourly_earnings_mom", "avg_hourly_earnings_yoy"],
      "interpretationHint": "Focus on payroll breadth, revisions, unemployment/participation mix and wage momentum."
    },
    {
      "id": "us_jolts",
      "name": "Job Openings and Labor Turnover Survey",
      "sourceAgency": "BLS",
      "category": "labor",
      "frequency": "monthly",
      "importance": "medium",
      "usualReleaseTimeET": "10:00",
      "officialCalendarUrl": "https://www.bls.gov/schedule/news_release/jolts.htm",
      "officialDataUrl": "https://www.bls.gov/jlt/",
      "primarySeries": ["JTSJOL"],
      "reportFields": ["job_openings", "quits_rate", "hires_rate", "layoffs_rate", "revision_status"],
      "interpretationHint": "Openings and quits help read labor demand cooling, but series is revision-prone."
    },
    {
      "id": "us_initial_claims",
      "name": "Unemployment Insurance Weekly Claims",
      "sourceAgency": "Department of Labor",
      "category": "labor",
      "frequency": "weekly",
      "importance": "medium",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.dol.gov/ui/data.pdf",
      "officialDataUrl": "https://oui.doleta.gov/unemploy/claims.asp",
      "primarySeries": ["ICSA", "CCSA"],
      "reportFields": ["initial_claims", "continued_claims", "four_week_average", "revision_status"],
      "interpretationHint": "Watch sustained trend changes rather than one-week noise."
    },
    {
      "id": "us_pce_income_outlays",
      "name": "Personal Income and Outlays / PCE Prices",
      "sourceAgency": "BEA",
      "category": "inflation_consumption",
      "frequency": "monthly",
      "importance": "high",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.bea.gov/news/schedule",
      "officialDataUrl": "https://www.bea.gov/data/income-saving/personal-income",
      "primarySeries": ["PCEPI", "PCEPILFE", "PCE"],
      "reportFields": ["personal_income_mom", "real_pce_mom", "pce_price_mom", "core_pce_mom", "core_pce_yoy", "revision_status"],
      "interpretationHint": "Core PCE is the Fed's preferred inflation gauge; consumption/income mix matters for demand."
    },
    {
      "id": "us_gdp",
      "name": "Gross Domestic Product",
      "sourceAgency": "BEA",
      "category": "growth",
      "frequency": "quarterly",
      "importance": "high",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.bea.gov/news/schedule",
      "officialDataUrl": "https://www.bea.gov/data/gdp/gross-domestic-product",
      "primarySeries": ["GDPC1"],
      "reportFields": ["real_gdp_qoq_saar", "consumption", "investment", "government", "net_exports", "price_index", "release_iteration"],
      "interpretationHint": "Separate headline GDP from domestic private demand and price components."
    },
    {
      "id": "us_retail_sales",
      "name": "Advance Monthly Retail Trade Survey",
      "sourceAgency": "Census Bureau",
      "category": "growth_consumption",
      "frequency": "monthly",
      "importance": "high",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.census.gov/economic-indicators/calendar-listview.html",
      "officialDataUrl": "https://www.census.gov/retail/index.html",
      "primarySeries": ["RSAFS"],
      "reportFields": ["headline_mom", "ex_auto_mom", "control_group_mom", "prior_revisions"],
      "interpretationHint": "Control group is most relevant for real consumption tracking."
    },
    {
      "id": "us_durable_goods",
      "name": "Advance Durable Goods Manufacturers' Shipments, Inventories and Orders",
      "sourceAgency": "Census Bureau",
      "category": "growth_capex",
      "frequency": "monthly",
      "importance": "medium",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.census.gov/economic-indicators/calendar-listview.html",
      "officialDataUrl": "https://www.census.gov/manufacturing/m3/",
      "primarySeries": [],
      "reportFields": ["headline_orders_mom", "ex_transport_mom", "core_capex_orders_mom", "core_capex_shipments_mom", "prior_revisions"],
      "interpretationHint": "Core capital goods orders/shipments are better capex signals than volatile headline."
    },
    {
      "id": "us_housing_starts",
      "name": "New Residential Construction",
      "sourceAgency": "Census Bureau / HUD",
      "category": "housing",
      "frequency": "monthly",
      "importance": "medium",
      "usualReleaseTimeET": "08:30",
      "officialCalendarUrl": "https://www.census.gov/economic-indicators/calendar-listview.html",
      "officialDataUrl": "https://www.census.gov/construction/nrc/",
      "primarySeries": ["HOUST", "PERMIT"],
      "reportFields": ["housing_starts", "building_permits", "single_family", "multi_family", "prior_revisions"],
      "interpretationHint": "Permits lead starts; rate sensitivity and regional detail can matter."
    },
    {
      "id": "us_industrial_production",
      "name": "Industrial Production and Capacity Utilization",
      "sourceAgency": "Federal Reserve",
      "category": "growth_industrial",
      "frequency": "monthly",
      "importance": "medium",
      "usualReleaseTimeET": "09:15",
      "officialCalendarUrl": "https://www.federalreserve.gov/releases/g17/current/default.htm",
      "officialDataUrl": "https://www.federalreserve.gov/releases/g17/",
      "primarySeries": ["INDPRO", "TCU"],
      "reportFields": ["industrial_production_mom", "manufacturing_output_mom", "capacity_utilization", "prior_revisions"],
      "interpretationHint": "Useful for cyclicals and industrial demand; watch manufacturing vs utilities/mining mix."
    },
    {
      "id": "us_fomc_decision",
      "name": "FOMC Rate Decision / Statement / SEP",
      "sourceAgency": "Federal Reserve",
      "category": "policy",
      "frequency": "scheduled",
      "importance": "high",
      "usualReleaseTimeET": "14:00",
      "officialCalendarUrl": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm",
      "officialDataUrl": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm",
      "primarySeries": ["FEDFUNDS", "DFEDTARU", "DFEDTARL"],
      "reportFields": ["target_range", "statement_changes", "dot_plot_if_sep", "press_conference_tone"],
      "interpretationHint": "Separate decision, statement delta, SEP/dots and Powell Q&A."
    },
    {
      "id": "us_treasury_daily_statement",
      "name": "Daily Treasury Statement / TGA",
      "sourceAgency": "U.S. Treasury Fiscal Data",
      "category": "liquidity_treasury",
      "frequency": "daily",
      "importance": "medium",
      "usualReleaseTimeET": "16:00",
      "officialCalendarUrl": "https://fiscaldata.treasury.gov/datasets/daily-treasury-statement/",
      "officialDataUrl": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v1/accounting/dts/operating_cash_balance",
      "primarySeries": [],
      "reportFields": ["tga_opening_balance", "deposits", "withdrawals", "record_date"],
      "interpretationHint": "TGA changes can affect liquidity context; do not overinterpret one-day moves."
    }
  ]
}
